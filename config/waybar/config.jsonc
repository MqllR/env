{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 8,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "tray", "custom/power"],

  "sway/workspaces": { "disable-scroll": true, "all-outputs": true, "format": "{name}" },
  "clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%A, %d %B %Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": { "format": "󰻠 {usage}%", "interval": 5 },
  "memory": { "format": "󰍛 {percentage}%", "interval": 5 },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤭 offline",
    "tooltip-format": "{ifname}: {ipaddr}  ({signalStrength}%)"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol"
  },
  "tray": { "spacing": 10 },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Session menu",
    "on-click": "~/.config/sway/power-menu.sh"
  }
}
